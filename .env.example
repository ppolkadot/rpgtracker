# Copy to .env (or secrets.env) and fill in. Never commit the real file.

# Discord webhook the alerts are posted to (required)
DISCORD_WEBHOOK_URL=

# Discord role id to ping via the {role_ping} placeholder (optional)
# PING_ROLE_ID is also accepted as an alias.
ROLE_ID=

# Path to the streamer config (optional, defaults to config.json)
# CONFIG_PATH=config.json

# Log level: error, warn, info, debug (optional, defaults to info)
# RUST_LOG=info
